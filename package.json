{
  "name": "blueprint-theme",
  "private": true,
  "type": "module",
  "description": "Blueprint 配色トークンの正本と、CSS / VSCode / Zed テーマの生成器",
  "scripts": {
    "gen": "node src/gen-css.ts && node src/gen-vscode.ts && node src/gen-zed.ts",
    "install:vscode": "node src/gen-vscode.ts && node src/pack-vscode.ts --install",
    "install:zed": "node src/gen-zed.ts && ln -sf \"$PWD/dist/zed/blueprint.json\" ~/.config/zed/themes/blueprint.json",
    "sync:report": "node src/gen-css.ts --into ../agent-setup/templates/report-theme.css",
    "switch": "node src/switch-day.ts",
    "preview": "node src/gen-preview.ts --open",
    "audit": "node src/audit.ts",
    "demo": "node src/gen-demo.ts --open",
    "build:pages": "node src/gen-demo.ts --pages && node src/gen-preview.ts --pages"
  }
}
