{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint core color group",
  "description": "core 色のグループ。各メンバーの色が primary (action) と accent になり、下地はその色相に染まる。読み込み時の検証は src/groups.ts",
  "type": "object",
  "required": ["id", "label", "members"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*$", "description": "出力名に入る。week だけは互換のため出力名に付けない" },
    "label": { "type": "string" },
    "note": { "type": "string" },
    "kind": {
      "enum": ["rotation", "choice"],
      "default": "rotation",
      "description": "rotation = 日によって入れ替わる (曜日・季節)。並べて見分けられる必要がある / choice = 好みで 1 つ選ぶ。メンバー同士は近くてよい"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "color"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
          "label": { "type": "string", "description": "英字の表示名 (テーマ名の末尾)" },
          "ja": { "type": "string", "description": "1〜2 文字の短い表示名 (見本・カード)" },
          "motif": { "type": "string", "description": "色の由来" },
          "color": {
            "type": "object",
            "required": ["dark", "light"],
            "additionalProperties": false,
            "properties": {
              "dark": { "$ref": "#/$defs/hex", "description": "暗い地 (dark テーマ) 用" },
              "light": { "$ref": "#/$defs/hex", "description": "明るい地 (light テーマ) 用" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
